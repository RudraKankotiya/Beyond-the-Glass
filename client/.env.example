# Base URL of the Express API (Vite only exposes variables prefixed with VITE_).
# Local: http://localhost:5000/api
# Vercel: your Render service, e.g. https://beyond-the-glass-api.onrender.com/api
# It is built into the JavaScript, so redeploy on Vercel after changing it.
VITE_API_URL=http://localhost:5000/api
