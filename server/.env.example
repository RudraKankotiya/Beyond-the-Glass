# ---------------------------------------------------------------------------------------------
# Copy to server/.env for local development.
# ---------------------------------------------------------------------------------------------

NODE_ENV=development

# Port the Express API listens on
PORT=5000

# MongoDB local connection string
MONGO_URI=mongodb://127.0.0.1:27017/beyond-the-glass

# Secret used to sign login tokens (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Address of the React client allowed to call the API (CORS)
CLIENT_URL=http://localhost:5173

# Local uploads folder (server/uploads)
STORAGE_DRIVER=local

