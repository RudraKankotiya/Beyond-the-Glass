# ---------------------------------------------------------------------------------------------
# Copy to server/.env for local development. On Render, set the same names under Environment.
# ---------------------------------------------------------------------------------------------

# "production" on Render: hides error details from API responses
NODE_ENV=development

# Port the Express API listens on (Render sets this automatically)
PORT=5000

# MongoDB connection string: local MongoDB, or MongoDB Atlas in production
# (mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/beyond-the-glass?retryWrites=true&w=majority)
MONGO_URI=mongodb://127.0.0.1:27017/beyond-the-glass

# Secret used to sign login tokens (JWT). Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Address(es) of the React client allowed to call the API (CORS), comma-separated
# e.g. https://beyond-the-glass.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Where uploaded 3D models and thumbnails are stored:
#   local      - in server/uploads (development)
#   cloudinary - on Cloudinary (production on Render, whose free disk is wiped on restart)
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=cloudinary. Copy "API environment variable" from the
# Cloudinary dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
